# docker-compose dev env — copy to .env
# Postgres/MinIO creds are baked into docker-compose.yml; these are the
# externally-provided secrets.

# Backend security and billing. Generate a unique SECRET_KEY for every real
# environment. Paddle values come from the live/sandbox account and must never
# be committed. The API /healthz remains degraded while any is absent.
SECRET_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Explicit on real deployments; "sandbox" keeps /healthz degraded.
PADDLE_MODE=production

# Browser clients allowed to call the API in addition to valmera.io,
# www.valmera.io, and local development on port 3000. Comma-separated exact
# origins only; wildcards and values containing paths are ignored.
CORS_ALLOWED_ORIGINS=

# LLM (OpenAI-compatible). Leave OPENAI_API_KEY empty to disable the agent,
# or point OPENAI_BASE_URL at scripts/fake_llm.py for keyless testing.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-luna
VISION_MODEL=gpt-5.6-luna

# Brevo account-wide UTC-day budget. Routine/newsletter mail stops at 280 so
# verification, billing, and founder subscription alerts retain 20 of the
# 300 daily sends.
BREVO_API_KEY=
BREVO_DAILY_LIMIT=300
BREVO_BULK_LIMIT=280
BREVO_CRITICAL_RESERVE=20

# Cost dashboard. R2 Standard's current public storage rate is the default.
# Put the monthly Render + managed Postgres bill in the fixed-cost value to
# include it in the 30-day cash-margin card.
R2_STORAGE_USD_PER_GB_MONTH=0.015
DATABASE_STORAGE_GB=5
RENDER_POSTGRES_STORAGE_USD_PER_GB_MONTH=0.30
PLATFORM_FIXED_COST_USD_MONTH=0

# Openverse powers stock-photo, music, and sound-effect search. Anonymous
# access remains available, but production should use either a bearer token or
# the client credentials from https://api.openverse.org/v1/auth_tokens/register/
# so provider throttling cannot waste an agent turn.
OPENVERSE_API_TOKEN=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Transcription size/speed tradeoff for local dev
WHISPER_MODEL=tiny

# Optional Cloudflare Containers canary. Keep at 0 until the manual deploy,
# ownership migration and provider performance gates are complete.
CLOUDFLARE_EXECUTOR_ENABLED=0
CLOUDFLARE_EXECUTOR_URL=
CLOUDFLARE_EXECUTOR_PERCENT=0
CLOUDFLARE_EXECUTOR_TYPES=preview_check,filmstrip,index
CLOUDFLARE_MODAL_FALLBACK=1

# AI sound-effect generation (ElevenLabs). Empty = the generate_sfx tool is
# hidden and the concierge won't offer custom sounds (the built-in CC0 pack
# still works). Set on the WORKER; the backend concierge only needs it to
# advertise the capability truthfully.
ELEVENLABS_API_KEY=
# SFX_PRICE_USD=0.08   # keep in sync with your ElevenLabs per-generation price

# AI video generation (fal.ai aggregator). Empty = the generate_video tool is
# hidden and the concierge keeps saying moving-video generation isn't available.
# Model is chosen entirely by env, like IMAGE_GEN_MODEL. Set FAL_KEY on the
# WORKER (backend concierge only reads it to advertise the capability).
FAL_KEY=
# VIDEO_GEN_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# VIDEO_BASE_PRICE_USD=0.35   # first VIDEO_BASE_SECONDS seconds
# VIDEO_BASE_SECONDS=5
# VIDEO_PRICE_USD_PER_SEC=0.07  # keep ALL THREE synced to the fal model page
