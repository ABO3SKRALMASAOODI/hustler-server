{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valmera.local/schemas/coordinator-run-result.schema.json",
  "title": "Valmera coordinator run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "run_id",
    "topic",
    "parent_project_id",
    "source_youtube_video_id",
    "source_asset_id",
    "source_sha256",
    "reference_youtube_video_id",
    "reference_asset_id",
    "reference_sha256",
    "selection_fingerprint",
    "status",
    "abstained",
    "abstain_reason",
    "blocked_phase",
    "blocked_reason",
    "blocked_evidence",
    "selected_arc_count",
    "accounted_arc_count",
    "generated_count",
    "pending_count",
    "failed_generation_count",
    "ready_count",
    "blocked_count",
    "arc_accounting"
  ],
  "properties": {
    "schema_version": {"const": "valmera-coordinator-run-result-v2"},
    "prompt_version": {"const": "valmera-shorts-editor-v6"},
    "run_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "parent_project_id": {"type": ["integer", "null"], "minimum": 1},
    "source_youtube_video_id": {
      "oneOf": [{"$ref": "#/$defs/youtubeVideoId"}, {"type": "null"}]
    },
    "source_asset_id": {"type": ["integer", "null"], "minimum": 1},
    "source_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "reference_youtube_video_id": {
      "oneOf": [
        {"$ref": "#/$defs/youtubeVideoId"},
        {"type": "null"}
      ]
    },
    "reference_asset_id": {"type": ["integer", "null"], "minimum": 1},
    "reference_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "selection_fingerprint": {
      "oneOf": [{"$ref": "#/$defs/prefixedSha256"}, {"type": "null"}]
    },
    "status": {
      "enum": [
        "in_progress",
        "ready_for_studio_export",
        "partial",
        "blocked",
        "abstained",
        "blocked_before_selection"
      ]
    },
    "abstained": {"type": "boolean"},
    "abstain_reason": {"type": ["string", "null"]},
    "blocked_phase": {
      "type": ["string", "null"],
      "enum": [
        "acquisition",
        "selection",
        "reference",
        "acquisition_record",
        "materialization",
        "child_qc",
        null
      ]
    },
    "blocked_reason": {"type": ["string", "null"], "minLength": 1},
    "blocked_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "selected_arc_count": {"type": "integer", "minimum": 0},
    "accounted_arc_count": {"type": "integer", "minimum": 0},
    "generated_count": {"type": "integer", "minimum": 0},
    "pending_count": {"type": "integer", "minimum": 0},
    "failed_generation_count": {"type": "integer", "minimum": 0},
    "ready_count": {"type": "integer", "minimum": 0},
    "blocked_count": {"type": "integer", "minimum": 0},
    "arc_accounting": {
      "type": "array",
      "items": {"$ref": "#/$defs/arcAccounting"}
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "status": {"const": "blocked_before_selection"},
            "abstained": {"const": false},
            "abstain_reason": {"type": "null"},
            "reference_youtube_video_id": {"type": "null"},
            "reference_asset_id": {"type": "null"},
            "reference_sha256": {"type": "null"},
            "selection_fingerprint": {"type": "null"},
            "blocked_phase": {"enum": ["acquisition", "selection"]},
            "blocked_reason": {"type": "string", "minLength": 1},
            "blocked_evidence": {"minItems": 1},
            "selected_arc_count": {"const": 0},
            "accounted_arc_count": {"const": 0},
            "generated_count": {"const": 0},
            "pending_count": {"const": 0},
            "failed_generation_count": {"const": 0},
            "ready_count": {"const": 0},
            "blocked_count": {"const": 0},
            "arc_accounting": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "status": {"const": "abstained"},
            "abstained": {"const": true},
            "abstain_reason": {"type": "string", "minLength": 1},
            "parent_project_id": {"type": "integer", "minimum": 1},
            "source_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
            "source_asset_id": {"type": "integer", "minimum": 1},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "reference_youtube_video_id": {"type": "null"},
            "reference_asset_id": {"type": "null"},
            "reference_sha256": {"type": "null"},
            "selection_fingerprint": {"$ref": "#/$defs/prefixedSha256"},
            "blocked_phase": {"type": "null"},
            "blocked_reason": {"type": "null"},
            "blocked_evidence": {"maxItems": 0},
            "selected_arc_count": {"const": 0},
            "accounted_arc_count": {"const": 0},
            "generated_count": {"const": 0},
            "pending_count": {"const": 0},
            "failed_generation_count": {"const": 0},
            "ready_count": {"const": 0},
            "blocked_count": {"const": 0},
            "arc_accounting": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "status": {"enum": ["in_progress", "ready_for_studio_export", "partial"]},
            "abstained": {"const": false},
            "abstain_reason": {"type": "null"},
            "parent_project_id": {"type": "integer", "minimum": 1},
            "source_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
            "source_asset_id": {"type": "integer", "minimum": 1},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "reference_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
            "reference_asset_id": {"type": "integer", "minimum": 1},
            "reference_sha256": {"$ref": "#/$defs/sha256"},
            "selection_fingerprint": {"$ref": "#/$defs/prefixedSha256"},
            "blocked_phase": {"type": "null"},
            "blocked_reason": {"type": "null"},
            "blocked_evidence": {"maxItems": 0},
            "selected_arc_count": {"type": "integer", "minimum": 1},
            "accounted_arc_count": {"type": "integer", "minimum": 1},
            "arc_accounting": {"minItems": 1}
          }
        },
        {
          "properties": {
            "status": {"const": "blocked"},
            "abstained": {"const": false},
            "abstain_reason": {"type": "null"},
            "parent_project_id": {"type": "integer", "minimum": 1},
            "source_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
            "source_asset_id": {"type": "integer", "minimum": 1},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "selection_fingerprint": {"$ref": "#/$defs/prefixedSha256"},
            "blocked_phase": {
              "enum": ["reference", "acquisition_record", "materialization", "child_qc"]
            },
            "blocked_reason": {"type": "string", "minLength": 1},
            "blocked_evidence": {"minItems": 1},
            "selected_arc_count": {"type": "integer", "minimum": 1},
            "accounted_arc_count": {"type": "integer", "minimum": 1},
            "ready_count": {"const": 0},
            "arc_accounting": {"minItems": 1}
          }
        }
      ]
    },
    {
      "if": {
        "properties": {"status": {"const": "ready_for_studio_export"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "pending_count": {"const": 0},
          "failed_generation_count": {"const": 0},
          "blocked_count": {"const": 0},
          "arc_accounting": {
            "items": {
              "properties": {
                "generation_status": {"const": "generated"},
                "editor_status": {"const": "ready"},
                "parent_qc_status": {"const": "pass"},
                "failed_gates": {"maxItems": 0}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "partial"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "pending_count": {"const": 0},
          "ready_count": {"type": "integer", "minimum": 1},
          "arc_accounting": {
            "allOf": [
              {
                "contains": {
                  "not": {
                    "properties": {
                      "generation_status": {"const": "generated"},
                      "editor_status": {"const": "ready"},
                      "parent_qc_status": {"const": "pass"}
                    },
                    "required": [
                      "generation_status",
                      "editor_status",
                      "parent_qc_status"
                    ]
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "editor_status": {"not": {"const": "blocked"}},
                    "parent_qc_status": {"not": {"const": "blocked"}}
                  },
                  "required": ["editor_status", "parent_qc_status"]
                }
              }
            ]
          }
        },
        "anyOf": [
          {"properties": {"failed_generation_count": {"minimum": 1}}},
          {"properties": {"blocked_count": {"minimum": 1}}}
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"},
          "blocked_phase": {"const": "reference"}
        },
        "required": ["status", "blocked_phase"]
      },
      "then": {
        "properties": {
          "generated_count": {"const": 0},
          "failed_generation_count": {"const": 0},
          "ready_count": {"const": 0},
          "blocked_count": {"const": 0},
          "arc_accounting": {
            "items": {
              "properties": {"generation_status": {"const": "pending"}}
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "reference_youtube_video_id": {"type": "null"},
              "reference_asset_id": {"type": "null"},
              "reference_sha256": {"type": "null"}
            }
          },
          {
            "properties": {
              "reference_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
              "reference_asset_id": {"type": "null"},
              "reference_sha256": {"type": "null"}
            }
          },
          {
            "properties": {
              "reference_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
              "reference_asset_id": {"type": "integer", "minimum": 1},
              "reference_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"},
          "blocked_phase": {
            "enum": ["acquisition_record", "materialization", "child_qc"]
          }
        },
        "required": ["status", "blocked_phase"]
      },
      "then": {
        "properties": {
          "reference_youtube_video_id": {"$ref": "#/$defs/youtubeVideoId"},
          "reference_asset_id": {"type": "integer", "minimum": 1},
          "reference_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"},
          "blocked_phase": {"const": "acquisition_record"}
        },
        "required": ["status", "blocked_phase"]
      },
      "then": {
        "properties": {
          "generated_count": {"const": 0},
          "failed_generation_count": {"const": 0},
          "ready_count": {"const": 0},
          "blocked_count": {"const": 0},
          "arc_accounting": {
            "items": {
              "properties": {"generation_status": {"const": "pending"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"},
          "blocked_phase": {"const": "materialization"}
        },
        "required": ["status", "blocked_phase"]
      },
      "then": {
        "properties": {
          "generated_count": {"const": 0},
          "pending_count": {"const": 0},
          "failed_generation_count": {"type": "integer", "minimum": 1},
          "ready_count": {"const": 0},
          "blocked_count": {"const": 0},
          "arc_accounting": {
            "items": {
              "properties": {"generation_status": {"const": "failed"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"},
          "blocked_phase": {"const": "child_qc"}
        },
        "required": ["status", "blocked_phase"]
      },
      "then": {
        "properties": {
          "reference_asset_id": {"type": "integer", "minimum": 1},
          "reference_sha256": {"$ref": "#/$defs/sha256"},
          "generated_count": {"type": "integer", "minimum": 1},
          "pending_count": {"const": 0},
          "ready_count": {"const": 0},
          "blocked_count": {"type": "integer", "minimum": 1},
          "arc_accounting": {
            "items": {
              "if": {
                "properties": {"generation_status": {"const": "generated"}},
                "required": ["generation_status"]
              },
              "then": {
                "properties": {
                  "editor_status": {"const": "blocked"},
                  "parent_qc_status": {"const": "blocked"},
                  "failed_gates": {"minItems": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["ready_for_studio_export", "partial", "blocked"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "arc_accounting": {
            "items": {
              "if": {
                "properties": {"generation_status": {"const": "generated"}},
                "required": ["generation_status"]
              },
              "then": {
                "properties": {
                  "generation_job_id": {
                    "oneOf": [
                      {"type": "string", "minLength": 1},
                      {"type": "integer", "minimum": 1}
                    ]
                  },
                  "treatment_name": {"type": "string", "minLength": 1},
                  "reference_adaptation_summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "editor_status": {"const": "ready"},
                      "parent_qc_status": {"const": "pass"},
                      "failed_gates": {"maxItems": 0}
                    }
                  },
                  {
                    "properties": {
                      "editor_status": {"const": "blocked"},
                      "parent_qc_status": {"const": "blocked"},
                      "failed_gates": {"minItems": 1}
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "youtubeVideoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "prefixedSha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?:sha256:)?[A-Fa-f0-9]{64}$"
    },
    "arcAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arc_id",
        "selection_rank",
        "start_s",
        "end_s",
        "title",
        "generation_status",
        "assignment_input_fingerprint",
        "editor_result_fingerprint",
        "parent_qc_fingerprint",
        "child_project_id",
        "generation_job_id",
        "generation_failure",
        "editor_status",
        "parent_qc_status",
        "live_edl_version",
        "preview_edl_version",
        "treatment_name",
        "reference_adaptation_summary",
        "failed_gates"
      ],
      "properties": {
        "arc_id": {"type": "string", "minLength": 1},
        "selection_rank": {"type": "integer", "minimum": 1},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "title": {"type": "string", "minLength": 1},
        "generation_status": {"enum": ["generated", "pending", "failed"]},
        "assignment_input_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/prefixedSha256"},
            {"type": "null"}
          ]
        },
        "editor_result_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/prefixedSha256"},
            {"type": "null"}
          ]
        },
        "parent_qc_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/prefixedSha256"},
            {"type": "null"}
          ]
        },
        "child_project_id": {"type": ["integer", "null"], "minimum": 1},
        "generation_job_id": {"type": ["string", "integer", "null"]},
        "generation_failure": {"type": ["string", "null"]},
        "editor_status": {
          "enum": ["not_started", "in_progress", "ready", "blocked", "failed"]
        },
        "parent_qc_status": {"enum": ["not_run", "pending", "pass", "blocked"]},
        "live_edl_version": {"type": ["integer", "null"], "minimum": 0},
        "preview_edl_version": {"type": ["integer", "null"], "minimum": 0},
        "treatment_name": {"type": ["string", "null"]},
        "reference_adaptation_summary": {"type": ["string", "null"]},
        "failed_gates": {
          "type": "array",
          "items": {
            "enum": [
              "generation",
              "story",
              "treatment",
              "reference",
              "picture",
              "broll",
              "captions",
              "music",
              "audio",
              "render"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"generation_status": {"const": "generated"}},
            "required": ["generation_status"]
          },
          "then": {
            "properties": {
              "assignment_input_fingerprint": {
                "$ref": "#/$defs/prefixedSha256"
              },
              "child_project_id": {"type": "integer", "minimum": 1},
              "generation_failure": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"generation_status": {"const": "pending"}},
            "required": ["generation_status"]
          },
          "then": {
            "properties": {
              "assignment_input_fingerprint": {"type": "null"},
              "editor_result_fingerprint": {"type": "null"},
              "parent_qc_fingerprint": {"type": "null"},
              "child_project_id": {"type": "null"},
              "generation_failure": {"type": "null"},
              "editor_status": {"const": "not_started"},
              "parent_qc_status": {"const": "not_run"},
              "live_edl_version": {"type": "null"},
              "preview_edl_version": {"type": "null"},
              "treatment_name": {"type": "null"},
              "reference_adaptation_summary": {"type": "null"},
              "failed_gates": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"generation_status": {"const": "failed"}},
            "required": ["generation_status"]
          },
          "then": {
            "properties": {
              "assignment_input_fingerprint": {"type": "null"},
              "editor_result_fingerprint": {"type": "null"},
              "parent_qc_fingerprint": {"type": "null"},
              "child_project_id": {"type": "null"},
              "generation_failure": {"type": "string", "minLength": 1},
              "editor_status": {"const": "failed"},
              "parent_qc_status": {"const": "not_run"},
              "live_edl_version": {"type": "null"},
              "preview_edl_version": {"type": "null"},
              "treatment_name": {"type": "null"},
              "reference_adaptation_summary": {"type": "null"},
              "failed_gates": {"contains": {"const": "generation"}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation_status": {"const": "generated"},
              "editor_status": {"const": "ready"},
              "parent_qc_status": {"const": "pass"}
            },
            "required": [
              "generation_status",
              "editor_status",
              "parent_qc_status"
            ]
          },
          "then": {
            "properties": {
              "assignment_input_fingerprint": {
                "$ref": "#/$defs/prefixedSha256"
              },
              "editor_result_fingerprint": {
                "$ref": "#/$defs/prefixedSha256"
              },
              "parent_qc_fingerprint": {
                "$ref": "#/$defs/prefixedSha256"
              },
              "child_project_id": {"type": "integer", "minimum": 1},
              "generation_job_id": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "integer", "minimum": 1}
                ]
              },
              "live_edl_version": {"type": "integer", "minimum": 0},
              "preview_edl_version": {"type": "integer", "minimum": 0},
              "treatment_name": {"type": "string", "minLength": 1},
              "reference_adaptation_summary": {"type": "string", "minLength": 1},
              "failed_gates": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
