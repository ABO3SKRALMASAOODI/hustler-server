# Agent-only dependency image. It deliberately omits the heavyweight assets
# that its tools already offload to the compute executor: Chromium, Whisper
# weights, segmentation weights, and torch/demucs. A much smaller image means
# "queued -> editing" cold starts are shorter without buying an idle instance.
FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg fontconfig fonts-dejavu-core fonts-noto-core fonts-noto-cjk \
       xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG FFMPEG_STATIC=1
RUN if [ "$FFMPEG_STATIC" = "1" ]; then \
      python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-linux64-gpl-8.1.tar.xz', '/tmp/ff.tar.xz')" \
      && tar -xJf /tmp/ff.tar.xz -C /tmp \
      && install -m755 /tmp/ffmpeg-*/bin/ffmpeg /usr/local/bin/ffmpeg \
      && install -m755 /tmp/ffmpeg-*/bin/ffprobe /usr/local/bin/ffprobe \
      && rm -rf /tmp/ff.tar.xz /tmp/ffmpeg-*; \
    fi

# URL imports still run inside the agent turn. Keep the anonymous YouTube PO
# token path, but none of the executor-only video/ML model payloads.
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip', '/tmp/deno.zip')" \
    && python -c "import zipfile; zipfile.ZipFile('/tmp/deno.zip').extractall('/tmp/deno-bin')" \
    && install -m755 /tmp/deno-bin/deno /usr/local/bin/deno \
    && rm -rf /tmp/deno.zip /tmp/deno-bin

ARG POT_VERSION=1.3.1
RUN pip install --no-cache-dir bgutil-ytdlp-pot-provider==${POT_VERSION} \
    && python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/Brainicism/bgutil-ytdlp-pot-provider/archive/refs/tags/${POT_VERSION}.tar.gz', '/tmp/bgutil.tgz')" \
    && mkdir -p /opt/bgutil-pot \
    && tar -xzf /tmp/bgutil.tgz -C /opt/bgutil-pot --strip-components=1 \
    && rm /tmp/bgutil.tgz \
    && cd /opt/bgutil-pot/server \
    && deno install --allow-scripts=npm:canvas --frozen

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONUNBUFFERED=1 \
    WORKER_TMP_DIR=/tmp/valmera \
    HF_HOME=/tmp/hf \
    PLAYWRIGHT_BROWSERS_PATH=/tmp/no-local-browser \
    TORCH_HOME=/tmp/no-local-torch
