{
  "id": "A",
  "name": "Manifesto",
  "genre": "motivational speech / quote edit",
  "exemplars": ["02", "04", "11", "13", "14"],
  "asks": ["manifesto", "motivational", "speech edit", "quote edit", "inspirational", "quote video"],
  "grammars": ["quote-reel", "voiceover-montage"],
  "structure": [
    {"beat": "hook", "at": "open", "devices": ["typeset_lockup", "recall_face_line"], "note": "the thesis as type on black, or faces on one eye line"},
    {"beat": "build", "at": "body", "devices": ["montage_cut", "typeset_lockup"], "note": "words on black -> words over picture -> picture (density arc)"},
    {"beat": "turn", "at": "turn", "devices": ["arrange_drop_hold", "accent_negative"], "note": "the bed out, a held breath"},
    {"beat": "payoff", "at": "payoff", "devices": ["typeset_lockup", "grade_section"], "note": "the drop on the payoff word; colour returns on it"},
    {"beat": "loop", "at": "end", "devices": ["recall_loop_rhyme"], "note": "the last frame rhymes with the first"}
  ],
  "palette": {"typeset_lockup": 3, "montage_cut": 1, "accent_negative": 2, "grade_section": 1, "arrange_drop_hold": 1, "recall_face_line": 1, "recall_loop_rhyme": 1, "junction_hit_flash": 1},
  "voices": ["condensed_poster", "editorial_serif", "quote_window", "staircase_red", "magazine"],
  "punctuation": ["accent_negative", "accent_white_hit"],
  "junctions": ["junction_hit_flash", "junction_dissolve"],
  "colour_world": {"rule": "graded colour; B&W only as a device: a stretch that opens to colour on the payoff, or one colour kept", "devices": ["bw_section_to_colour", "bw_keep_one_colour"], "never": ["whole_short_mono"]},
  "footage_quotas": {"broll_share": [0.3, 0.7], "type_on_black_share": [0.1, 0.35], "stills_max": 6}
}
