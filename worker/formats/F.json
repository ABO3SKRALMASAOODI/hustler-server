{
 "id": "F",
 "name": "Music-driven visual essay",
 "genre": "F",
 "intensity": "charged",
 "apply": "brief",
 "exemplars": [
  "17",
  "33",
  "36"
 ],
 "asks": [
  "visual essay",
  "essay",
  "music-driven essay",
  "cinematic essay",
  "video essay"
 ],
 "grammars": [],
 "structure": [
  {
   "beat": "open",
   "at": "open",
   "share": 0.15,
   "devices": [
    "depth_parallax",
    "typeset_lockup"
   ],
   "note": "a still that drifts in 2.5D, one line of type"
  },
  {
   "beat": "build",
   "at": "body",
   "share": 0.35,
   "devices": [
    "broll_archival",
    "broll_cutaway",
    "montage_cut"
   ],
   "note": "archival and sourced B-roll on the phrase, cuts on the user's track beats"
  },
  {
   "beat": "drop",
   "at": "payoff",
   "share": 0.35,
   "devices": [
    "montage_cut",
    "depth_dof",
    "time_echo",
    "accent_negative"
   ],
   "note": "the montage on 8ths, depth and time devices on the hits"
  },
  {
   "beat": "resolve",
   "at": "end",
   "share": 0.15,
   "devices": [
    "typeset_lockup",
    "depth_dof"
   ],
   "note": "a held frame, the last line"
  }
 ],
 "palette": {
  "broll_cutaway": 3,
  "broll_archival": 3,
  "montage_cut": 1,
  "depth_parallax": 2,
  "depth_dof": 2,
  "time_echo": 1,
  "time_interpolate": 1,
  "typeset_lockup": 3,
  "grade_section": 1,
  "accent_negative": 2,
  "junction_hit_flash": 1
 },
 "voices": [
  "condensed_poster",
  "editorial_serif",
  "hairline_wide",
  "slot_blackletter"
 ],
 "type_voice": "a serif or condensed display face; lines set as lockups on the cut",
 "punctuation": [
  "accent_negative",
  "accent_white_hit"
 ],
 "junctions": [
  "junction_hit_flash",
  "junction_columns"
 ],
 "colour_world": {
  "rule": "one colour world per section; B&W only as a device (sections with colour on the drop, one colour kept)",
  "palette": "from the user's footage",
  "devices": [
   "bw_section_to_colour",
   "bw_keep_one_colour"
  ],
  "never": [
   "whole_short_mono"
  ]
 },
 "look": {
  "grade": "one colour world per section; B&W only as a device (sections with colour on the drop, one colour kept)",
  "palette": "from the user's footage"
 },
 "captions": {
  "mode": "lockups",
  "position": "type in the world",
  "density": "line"
 },
 "budgets": {
  "punctuation": null,
  "matte": {
   "every_s": 8.0
  },
  "depth": {
   "every_s": 6.0
  },
  "world": {
   "every_s": 4.0
  },
  "rhythm": null
 },
 "devices_prefer": [
  "broll_cutaway",
  "broll_archival",
  "depth_parallax",
  "depth_dof",
  "time_echo",
  "time_interpolate"
 ],
 "devices_avoid": [
  "ui_scene_explainer"
 ],
 "footage_quotas": {
  "broll_share": [
   0.5,
   0.95
  ],
  "stills_max": 10
 },
 "never": [
  "picking the music (the user's track only)",
  "a whole-short black-and-white look",
  "more than 3 full-frame flashes per second without the user's opt-in"
 ],
 "aspect": "9:16",
 "notes": "Every section gets its own idea; the essay never repeats a device on consecutive shots."
}
