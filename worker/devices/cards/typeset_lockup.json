    "words the captions also show (it replaces them; it never duplicates them)"
  ],
  "owner_flags": {
    "adds_sound": false,
    "adds_zoom": false,
    "flash": false
  },
  "rungs": [
    "full",
    {
      "substitute": "phrase_build"
    },
    "omit"
  ],
  "cost": {
    "ms_per_frame": {
      "interactive": 60.0,
