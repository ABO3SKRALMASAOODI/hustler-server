  "cost": {
    "ms_per_frame": {
      "interactive": 30,
      "batch": 30,
      "local": 15
    },
    "fixed_ms": 1200
  },
  "exemplars": [
    "03@0–27.7",
    "30@41.7–44.7"
  ],
  "verify": [
    "determinism"
  ],
