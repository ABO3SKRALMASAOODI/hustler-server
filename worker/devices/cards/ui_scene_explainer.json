  "params": {
    "layout": [
      "stack",
      "grid",
      "focus",
      "thread",
      "row"
    ],
    "backdrop": [
      "solid",
      "dim"
    ],
    "span": [
      "section"
    ]
  },
  "needs": {
    "sidecars": [],
    "lane_features": [
      "chromium"
    ],
