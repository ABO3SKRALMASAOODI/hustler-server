# Cloudflare Containers image: the proven provider-neutral Python executor.
# The interactive build stays slim; the standard-4 batch build sets
# FULL_COMPUTE=1 and carries Chromium, segmentation, and Demucs so synchronous
# editor children do not escape to another compute provider.
FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg fontconfig fonts-dejavu-core fonts-noto-core fonts-noto-cjk \
       xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG FFMPEG_STATIC=1
RUN if [ "$FFMPEG_STATIC" = "1" ]; then \
      python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-linux64-gpl-8.1.tar.xz', '/tmp/ff.tar.xz')" \
      && tar -xJf /tmp/ff.tar.xz -C /tmp \
      && install -m755 /tmp/ffmpeg-*/bin/ffmpeg /usr/local/bin/ffmpeg \
      && install -m755 /tmp/ffmpeg-*/bin/ffprobe /usr/local/bin/ffprobe \
      && rm -rf /tmp/ff.tar.xz /tmp/ffmpeg-*; \
    fi

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ARG FULL_COMPUTE=0
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN if [ "$FULL_COMPUTE" = "1" ]; then \
      playwright install --with-deps chromium \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# URL acquisition needs the same anonymous YouTube challenge path as the full
# executor: Deno plus the pinned bgutil provider. Keep both version halves in
# the batch image so moving egress from Modal does not quietly reduce formats.
ARG POT_VERSION=1.3.1
RUN if [ "$FULL_COMPUTE" = "1" ]; then \
      python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip', '/tmp/deno.zip')" \
      && python -c "import zipfile; zipfile.ZipFile('/tmp/deno.zip').extractall('/tmp/deno-bin')" \
      && install -m755 /tmp/deno-bin/deno /usr/local/bin/deno \
      && rm -rf /tmp/deno.zip /tmp/deno-bin \
      && pip install --no-cache-dir bgutil-ytdlp-pot-provider==${POT_VERSION} \
      && python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/Brainicism/bgutil-ytdlp-pot-provider/archive/refs/tags/${POT_VERSION}.tar.gz', '/tmp/bgutil.tgz')" \
      && mkdir -p /opt/bgutil-pot \
      && tar -xzf /tmp/bgutil.tgz -C /opt/bgutil-pot --strip-components=1 \
      && rm /tmp/bgutil.tgz \
      && cd /opt/bgutil-pot/server \
      && deno install --allow-scripts=npm:canvas --frozen; \
    fi

# The batch image carries the same two person-matte models as the proven full
# executor. Model-backed code already falls back honestly when these are not
# present, which is why the interactive image can omit them.
RUN if [ "$FULL_COMPUTE" = "1" ]; then \
      mkdir -p /app/models \
      && python -c "import urllib.request, os; urllib.request.urlretrieve('https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net_human_seg.onnx', '/app/models/u2net_human_seg.onnx'); assert os.path.getsize('/app/models/u2net_human_seg.onnx') > 100_000_000" \
      && python -c "import urllib.request, os; urllib.request.urlretrieve('https://github.com/PeterL1n/RobustVideoMatting/releases/download/v1.0.0/rvm_mobilenetv3_fp32.onnx', '/app/models/rvm_mobilenetv3_fp32.onnx'); assert os.path.getsize('/app/models/rvm_mobilenetv3_fp32.onnx') > 10_000_000"; \
    fi

# CPU-only stem separation fits the 12-GiB batch profile. Keeping it out of
# the interactive image avoids adding its large Torch/model layers to preview
# cold starts.
ENV TORCH_HOME=/opt/torch
RUN if [ "$FULL_COMPUTE" = "1" ]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.4.1 torchaudio==2.4.1 \
      && pip install --no-cache-dir demucs==4.0.1 \
      && python -c "from demucs.pretrained import get_model; get_model('htdemucs'); print('htdemucs weights baked')"; \
    fi

ENV HF_HOME=/opt/hf
ARG WHISPER_MODEL=medium
# Interactive proof and filmstrip jobs never transcribe. Wrangler passes an
# empty build arg for that image so cold starts do not pull a multi-gigabyte
# model through Cloudflare's scheduler. The batch image keeps the exact proven
# local fallback used by index jobs.
RUN if [ -n "$WHISPER_MODEL" ]; then \
      python -c "from faster_whisper import download_model; download_model('${WHISPER_MODEL}')"; \
    fi

# Wrangler/BuildKit has reused a stale COPY layer during a production
# Containers rollout even though the worker checkout changed.  The content
# fingerprint is injected by the deploy workflow; changing it invalidates this
# cheap marker and every following source layer without rebuilding ffmpeg,
# Python dependencies, or Whisper.
ARG SOURCE_VERSION=unknown
RUN printf '%s\n' "$SOURCE_VERSION" > /opt/valmera-source-version

COPY . .

ENV PYTHONUNBUFFERED=1 \
    WORKER_ROLE=executor \
    EXECUTOR_PROVIDER=cloudflare \
    WORKER_TMP_DIR=/tmp/valmera \
    PORT=8080

CMD ["python", "http_server.py"]
