# Non-secret executor environment, identical to the Cloudflare lanes'
# (worker/cloudflare/src/index.ts environment()) except the provider.
# Secrets come from /etc/valmera/executor.env (box/provision.py).
PORT=8080
PYTHONUNBUFFERED=1
WORKER_TMP_DIR=/tmp/valmera
EXECUTION_POLICY_MODE=redesign
BOX_ROUTE_ALL=1
CLOUDFLARE_EXECUTOR_ENABLED=0
CLOUDFLARE_MODAL_FALLBACK=0
CLOUDFLARE_MAX_SOURCE_DURATION_S=0
CLOUDFLARE_EXECUTOR_TYPES=preview,preview_check,final,index,filmstrip,agent_turn,mcp_tool,shorts_plan,capture,frames,track,matte,smatch,clean,stems,fetch,search,stock_acquire,ytprobe,mcp_media,faces,sidecar
CLOUDFLARE_SYNCHRONOUS_TYPES=capture,frames,track,matte,smatch,clean,stems,fetch,search,stock_acquire,ytprobe,mcp_media,faces,sidecar
VISION_LANE_ENABLED=0
MODAL_EXECUTOR_ENABLED=0
MODAL_EXECUTOR_PERCENT=0
S3_REGION=auto
