[Unit]
Description=Valmera box admission (priority queue in front of executor slots)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/valmera/box/admission.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536
# Admission must survive memory pressure the executors create.
OOMScoreAdjust=-900
Nice=-5

[Install]
WantedBy=multi-user.target
